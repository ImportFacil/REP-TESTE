# Copie para .env e ajuste. Nunca coloque segredos reais neste arquivo.
AMBIENTE=local
PORTA=3000
DATABASE_URL=postgres://importfacil:importfacil@localhost:5432/importfacil
# Login de desenvolvimento (tokens gerados com: npm run token-dev -- <email> <cliente|equipe>)
AUTH_MODO=dev
AUTH_SEGREDO_DEV=troque-este-segredo-local
CORS_ORIGENS=http://localhost:3001

# A API também roda as rotinas e consome a fila, sem um worker separado (homologação na AWS usa assim).
# WORKER_NA_API=true
