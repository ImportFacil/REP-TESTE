{
  "name": "importfacil-api",
  "version": "0.1.0",
  "private": true,
  "description": "API da plataforma ImportFácil (fase 1: contas, catálogo e preços)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1162.0",
    "@aws-sdk/client-s3": "3.1162.0",
    "@aws-sdk/client-sqs": "3.1162.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.7.1",
    "@sentry/node": "9.47.2",
    "aws-jwt-verify": "5.2.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "kysely": "0.28.19",
    "nestjs-pino": "4.6.1",
    "pg": "8.23.1",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/testing": "11.2.8",
    "@types/jest": "29.5.14",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "jose": "5.10.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/banco/dados','dist/banco/dados',{recursive:true})\"",
    "start": "node dist/main.js",
    "dev": "npm run build && AMBIENTE=local node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "jest --selectProjects unidade",
    "test:api": "jest --selectProjects api --runInBand",
    "migrar": "node dist/banco/migrar.js",
    "semear": "node dist/banco/semear.js",
    "criar-admin": "node dist/scripts/criar-admin.js",
    "token-dev": "node dist/scripts/token-dev.js",
    "worker": "node dist/worker.js"
  }
}
